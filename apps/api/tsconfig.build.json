{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "./dist",
    "declaration": false,
    "incremental": false,
    "verbatimModuleSyntax": false,
    "isolatedModules": false
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
