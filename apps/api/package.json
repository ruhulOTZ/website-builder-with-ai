{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "ts-node --transpile-only --project tsconfig.build.json src/main.ts",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "test": "jest",
    "eval:parse": "ts-node --transpile-only --project tsconfig.build.json scripts/eval-parse.ts",
    "eval:brief": "ts-node --transpile-only --project tsconfig.build.json scripts/eval-brief.ts",
    "eval:cache:verify": "ts-node --transpile-only --project tsconfig.build.json scripts/verify-cache-key.ts",
    "eval:cache:verify:brief": "ts-node --transpile-only --project tsconfig.build.json scripts/verify-brief-cache-key.ts",
    "verify:brief-to-theme": "ts-node --transpile-only --project tsconfig.build.json scripts/verify-brief-to-theme.ts",
    "diagnose:truncation": "ts-node --transpile-only --project tsconfig.build.json scripts/diagnose-truncation.ts",
    "smoke:brief": "ts-node --transpile-only --project tsconfig.build.json scripts/smoke-brief.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@repo/ai": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.3"
  }
}
