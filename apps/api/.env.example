# apps/api environment

DATABASE_URL="postgresql://builder:builder@localhost:5432/builder?schema=public"
REDIS_URL="redis://localhost:6379"

API_PORT=3001
NODE_ENV=development

# Gemini (required by AiModule)
GEMINI_API_KEY=

# Unsplash (optional — when unset, generated sites render without resolved
# photo URLs and the renderer falls back to placeholder scrims).
# Get a free demo key (50 req/hour) at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
