# Root reference. Per-app env files live at apps/api/.env.example and apps/web/.env.example.
# Each app loads its own .env; this file documents the full set used across the monorepo.

# Postgres (consumed by apps/api via @repo/database)
DATABASE_URL="postgresql://builder:builder@localhost:5432/builder?schema=public"

# Redis (consumed by apps/api)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3001
NODE_ENV=development

# Web -> API
NEXT_PUBLIC_API_URL="http://localhost:3001"

# AI provider keys
GEMINI_API_KEY=
# Wired in a later step:
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Unsplash (optional). Free demo key at https://unsplash.com/developers.
# When unset, generated sites render with placeholder scrims instead of photos.
UNSPLASH_ACCESS_KEY=
